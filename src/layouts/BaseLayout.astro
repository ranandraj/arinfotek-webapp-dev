---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'AR INFOTEK | Product Development & IT Training',
  description = 'AR INFOTEK builds products and delivers practical, mentor-led IT training in AI, Cloud, DevOps and Data Science.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ranandraj.github.io').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <a class="whatsapp" href="https://wa.me/919487107253?text=Hi%20AR%20INFOTEK%2C%20I%20would%20like%20to%20know%20more" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">WhatsApp</a>
  </body>
</html>
