---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h4>AR INFOTEK</h4>
      <p class="small">Software development and practical, mentor-led IT training.</p>
      <p class="small">admissions@arinfotek.co.in<br />+91-9487107253</p>
    </div>
    <div>
      <h4>Training</h4>
      <p class="small"><a href={`${base}courses/`}>Courses</a></p>
      <p class="small"><a href={`${base}batches/`}>Upcoming batches</a></p>
      <p class="small"><a href={`${base}internship/`}>Internship</a></p>
      <p class="small"><a href={`${base}placement/`}>Placement & Hiring</a></p>
      <p class="small"><a href={`${base}testimonials/`}>Testimonials</a></p>
      <p class="small"><a href={`${base}faq/`}>FAQ</a></p>
      <p class="small"><a href={`${base}blog/`}>Career blog</a></p>
    </div>
    <div>
      <h4>Business</h4>
      <p class="small"><a href={`${base}software-development/`}>Software Development</a></p>
      <p class="small"><a href={`${base}case-studies/`}>Case Studies</a></p>
      <p class="small"><a href={`${base}pricing/`}>Pricing</a></p>
      <p class="small"><a href={`${base}contact/`}>Request a quote</a></p>
    </div>
    <div>
      <h4>Accounts</h4>
      <p class="small"><a href={`${base}signup/customer/`}>Customer signup</a></p>
      <p class="small"><a href={`${base}login/customer/`}>Customer login</a></p>
      <p class="small"><a href={`${base}signup/student/`}>Student signup</a></p>
      <p class="small"><a href={`${base}login/student/`}>Student login</a></p>
    </div>
  </div>
  <div class="container small">© {year} AR INFOTEK. All rights reserved.</div>
</footer>
