---
const { interest = 'General enquiry', heading = 'Tell us what you need' } = Astro.props;
const interests = [
  'Software Development',
  'AWS Cloud Architect',
  'Data Science & ML',
  'Cloud & DevOps',
  'Cybersecurity',
  'IT Training',
  'Placement & Hiring',
  'Internship',
  'Other',
];
---
<div class="card auth-card">
  <h3>{heading}</h3>
  <form class="lead-form" data-default-interest={interest}>
    <label for="lead-name">Name</label>
    <input id="lead-name" name="name" required placeholder="Your full name" />

    <label for="lead-email">Email</label>
    <input id="lead-email" name="email" type="email" required placeholder="you@example.com" />

    <label for="lead-phone">Phone / WhatsApp</label>
    <input id="lead-phone" name="phone" required placeholder="+91..." />

    <label for="lead-interest">I'm interested in</label>
    <select id="lead-interest" name="interest">
      {interests.map((item) => <option value={item} selected={item === interest}>{item}</option>)}
    </select>

    <label for="lead-message">Message</label>
    <textarea id="lead-message" name="message" rows="3" placeholder="Tell us about your goal"></textarea>

    <label class="small"><input type="checkbox" name="consent" required /> I agree to be contacted about my enquiry.</label>
    <button class="btn" type="submit">Send enquiry</button>
  </form>
  <div class="msg" data-lead-msg role="status"></div>
</div>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.querySelector<HTMLFormElement>('.lead-form');
  const msg = document.querySelector<HTMLElement>('[data-lead-msg]');

  if (form && msg) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      msg.textContent = 'Sending…';

      const data = new FormData(form);
      const { error } = await supabase.from('leads').insert({
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        phone: String(data.get('phone') ?? ''),
        interest: String(data.get('interest') ?? form.dataset.defaultInterest ?? 'General enquiry'),
        message: String(data.get('message') ?? ''),
        source: location.pathname,
      });

      if (error) {
        msg.textContent = `Could not send: ${error.message}`;
        return;
      }

      msg.textContent = 'Thanks — we will contact you shortly. You can also chat on WhatsApp.';
      form.reset();
    });
  }
</script>
