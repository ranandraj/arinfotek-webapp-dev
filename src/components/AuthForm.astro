---
const { mode = 'login', role = 'customer' } = Astro.props;
const base = import.meta.env.BASE_URL;
const isSignup = mode === 'signup';
---
<div class="auth-wrap">
  <div class="card auth-card">
    <span class="tag">{isSignup ? 'Create account' : 'Welcome back'} · {role}</span>
    <h2>{isSignup ? `Sign up as ${role}` : `Log in as ${role}`}</h2>
    <p class="small">Use your email address and password. {isSignup ? 'You will get a confirmation email.' : ''}</p>

    <form id="auth-form" data-mode={mode} data-role={role}>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />

      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete={isSignup ? 'new-password' : 'current-password'} minlength="6" required placeholder="Minimum 6 characters" />

      <button class="btn" type="submit">{isSignup ? 'Create account' : 'Log in'}</button>
    </form>

    <div id="auth-msg" class="msg" role="status"></div>
    <div class="switch">
      {isSignup ? (
        <span>Already registered? <a href={`${base}login/${role}/`}>Log in</a></span>
      ) : (
        <span>New here? <a href={`${base}signup/${role}/`}>Sign up</a></span>
      )}
      <br />
      <span>Looking for the other account type? <a href={`${base}${isSignup ? 'signup' : 'login'}/${role === 'customer' ? 'student' : 'customer'}/`}>{role === 'customer' ? 'Student' : 'Customer'} {isSignup ? 'signup' : 'login'}</a></span>
    </div>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.querySelector<HTMLFormElement>('#auth-form')!;
  const msg = document.querySelector<HTMLElement>('#auth-msg')!;
  const base = import.meta.env.BASE_URL;
  const mode = form.dataset.mode;
  const role = form.dataset.role ?? 'customer';

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    msg.textContent = 'Please wait…';

    const email = form.querySelector<HTMLInputElement>('#email')!.value;
    const password = form.querySelector<HTMLInputElement>('#password')!.value;

    if (mode === 'signup') {
      const { error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: { role },
          emailRedirectTo: new URL('auth/callback/', location.origin + base).toString(),
        },
      });
      msg.textContent = error ? error.message : 'Account created. Please check your email to confirm it.';
      return;
    }

    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) {
      msg.textContent = error.message;
      return;
    }

    const { data } = await supabase.auth.getUser();
    const userRole = data.user?.user_metadata?.role === 'student' ? 'student' : 'customer';
    location.href = new URL(`dashboard/${userRole}/`, location.origin + base).toString();
  });
</script>
