---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const courses = [
  { title: 'AWS Cloud Architect', duration: '16 weeks', text: 'VPC, IAM, EC2, load balancing and secure architecture.' },
  { title: 'Data Science & ML', duration: '14 weeks', text: 'Python, Pandas, machine learning models and MLOps basics.' },
  { title: 'Cloud & DevOps', duration: '12 weeks', text: 'Docker, Kubernetes, Terraform and CI/CD pipelines.' },
  { title: 'Cybersecurity', duration: '10 weeks', text: 'Network security, SIEM, threat modelling and Blue Team labs.' },
];
---
<BaseLayout title="Courses | AR INFOTEK" description="Live instructor-led IT training courses in cloud, DevOps, data science and security.">
  <section class="hero">
    <div class="container">
      <span class="tag">IT Training</span>
      <h1>In-demand tech skills, taught live</h1>
      <p>Small cohorts, practical projects and mentor support. Weekday and weekend batches.</p>
      <a class="btn" href={`${base}signup/student/`}>Join as a student</a>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid four">
        {courses.map((course) => (
          <div class="card">
            <span class="tag">{course.duration}</span>
            <h3>{course.title}</h3>
            <p>{course.text}</p>
            <a href={`${base}contact/`}>Enquire →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
