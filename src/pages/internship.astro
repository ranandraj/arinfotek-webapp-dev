---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const domains = ['AI / ML', 'Cloud Computing', 'Data Science', 'Full Stack Web Development', 'Python', 'Mobile Apps', 'DevOps', 'Vibe Coding'];
const highlights = [
  ['Real Projects', 'Work on industry-style assignments instead of theoretical exercises.'],
  ['Mentor Support', 'Get guidance from working professionals throughout the internship.'],
  ['Resume Ready', 'Build a portfolio and learn how to present your work in interviews.'],
  ['Certificate', 'Receive a completion certificate after successful project delivery.'],
];
const steps = [
  ['Apply', 'Share your background, preferred domain and availability.'],
  ['Counselling', 'Confirm fit, project scope and schedule with a mentor.'],
  ['Build', 'Complete guided tasks and a final project with mentor reviews.'],
  ['Review', 'Present your work, get feedback and receive your certificate.'],
];
const rubric = [
  ['Project completion', 'Deliverables submitted on time and documented clearly.'],
  ['Technical quality', 'Code structure, testing and sensible design decisions.'],
  ['Communication', 'Weekly updates and a clear final presentation.'],
  ['Initiative', ['Problem framing', 'Debugging', 'Additional improvements'].join(', ')],
];
---
<BaseLayout title="Internship | AR INFOTEK" description="Internship program 2026 with real projects, mentor reviews, certificate and placement support.">
  <section class="hero">
    <div class="container">
      <span class="tag">Internship Program 2026</span>
      <h1>Learn today. Intern tomorrow.</h1>
      <p>Real-world projects, industry exposure, resume building and interview preparation.</p>
      <div class="hero-actions">
        <a class="btn" href={`${base}signup/student/`}>Register interest</a>
        <a class="btn ghost" href={`${base}contact/`}>Ask a question</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Internship domains</h2>
      <div class="grid four">
        {domains.map((domain) => <div class="card"><h3>{domain}</h3><p>Practical assignment, mentor review and project submission.</p></div>)}
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="container">
      <h2>Program highlights</h2>
      <div class="grid four">
        {highlights.map(([title, text]) => <div class="card"><h3>{title}</h3><p>{text}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Application steps</h2>
      <div class="grid four">
        {steps.map(([title, text], index) => <div class="card"><span class="tag">{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="container">
      <div class="grid two">
        <div class="card">
          <h3>How you are evaluated</h3>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Criteria</th><th>What we look for</th></tr></thead>
              <tbody>
                {rubric.map(([title, text]) => <tr><td>{title}</td><td>{text}</td></tr>)}
              </tbody>
            </table>
          </div>
          <p class="small">Stipend availability depends on the project and performance; discuss this during counselling. A completion certificate is issued after successful delivery.</p>
        </div>
        <div class="card">
          <h3>Eligibility & fee</h3>
          <p>Open to BE, BCA, BSc, MCA and diploma students, as well as career switchers with basic programming knowledge.</p>
          <div class="price">₹1,999</div>
          <p>Duration: 4–8 weeks depending on domain and project complexity. Flexible weekday/weekend mentor sessions. Ask about batch transfers before enrolment.</p>
          <a class="btn" href={`${base}signup/student/`}>Register now</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <LeadForm interest="Internship" heading="Internship enquiry" />
    </div>
  </section>
</BaseLayout>
