---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const services = [
  { title: 'Web Application Development', text: 'Business websites, dashboards and portals built for speed and maintainability.' },
  { title: 'API & Backend Engineering', text: 'Secure REST APIs, integrations and database design.' },
  { title: 'Cloud & DevOps', text: 'AWS/Azure deployment, Docker, Kubernetes and CI/CD pipelines.' },
  { title: 'AI Integration', text: 'RAG chatbots, document intelligence and automation with modern AI tooling.' },
];
---
<BaseLayout title="Software Development | AR INFOTEK" description="Custom software, API, cloud and AI development services by AR INFOTEK.">
  <section class="hero">
    <div class="container">
      <span class="tag">Software Development</span>
      <h1>Software that solves real business problems</h1>
      <p>From idea to production: discovery, design, development, deployment and support — handled by practising engineers.</p>
      <a class="btn" href={`${base}contact/`}>Start a project</a>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>What we build</h2>
      <div class="grid two">
        {services.map((service) => (
          <div class="card">
            <span class="tag">Service</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
