---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const tracks = [
  {
    label: 'Practice 01',
    audience: 'For businesses',
    title: 'Product Development',
    summary: 'Web applications, APIs, cloud infrastructure, DevOps automation and AI integrations built by practising engineers.',
    points: ['Discovery to deployment', 'Clear milestones and ownership', 'Secure, maintainable code'],
    href: `${base}software-development/`,
    cta: 'Explore product development',
    tone: 'dev',
  },
  {
    label: 'Practice 02',
    audience: 'For learners',
    title: 'IT Training',
    summary: 'Live instructor-led courses with hands-on labs, real projects, internships and placement support for real roles.',
    points: ['Weekday and weekend batches', 'Projects you can show', 'Placement and hiring mentor'],
    href: `${base}courses/`,
    cta: 'Explore IT training',
    tone: 'training',
  },
];

const devFlow = [
  { no: '01', title: 'Discover', text: 'Goals, users, constraints and success criteria.' },
  { no: '02', title: 'Design', text: 'Architecture, wireframes and a milestone plan.' },
  { no: '03', title: 'Build', text: 'Agile sprints with reviews, tests and updates.' },
  { no: '04', title: 'Launch', text: 'Deployment, monitoring and future enhancements.' },
];

const trainingFlow = [
  { no: '01', title: 'Counselling', text: 'Choose the right track for your goal.' },
  { no: '02', title: 'Live labs', text: 'Work with mentors, not passive videos.' },
  { no: '03', title: 'Capstone', text: 'Build and present a real project.' },
  { no: '04', title: 'Placement', text: 'Profile, mocks and application tracking.' },
];

const proof = [
  { label: 'Engineering standard', title: 'Production-first thinking', text: 'Software is designed for security, maintainability and clear documentation from day one.' },
  { label: 'Learning standard', title: 'Project-first teaching', text: 'Learners build dashboards, deployments and intelligent assistants instead of only watching lectures.' },
  { label: 'Outcome standard', title: 'Support after delivery', text: 'Clients get a support path; learners get a hiring mentor and a practical 90-day plan.' },
];

const batches = [
  { name: 'AWS Architect', date: '25 Nov', mode: 'Weekdays', seats: '4 seats left' },
  { name: 'Data Science', date: '02 Dec', mode: 'Weekends', seats: '6 seats left' },
  { name: 'DevOps Master', date: '09 Dec', mode: 'Weekdays', seats: 'New batch' },
];

const studies = [
  ['Operations dashboard', 'Workflow, role-based access and reporting built as a phased release.'],
  ['Document assistant', 'RAG assistant over PDFs with citations and access control.'],
  ['Pipeline modernisation', 'Containers, automated tests and repeatable deployments.'],
];
---
<BaseLayout
  title="AR INFOTEK | Product Development & IT Training"
  description="AR INFOTEK runs two focused practices: product development for businesses and live IT training for learners."
>
  <section class="hero hero-home">
    <div class="container hero-grid">
      <div>
        <span class="tag">One company · Two focused practices</span>
        <h1>Build the product. Build the people.</h1>
        <p>AR INFOTEK helps businesses ship software and helps learners build job-ready technology skills. Two dedicated teams, two clear outcomes, one engineering standard.</p>
        <div class="hero-actions">
          <a class="btn" href="#tracks">Choose your track</a>
          <a class="btn ghost" href={`${base}contact/`}>Talk to us</a>
        </div>
        <p class="hero-note">Different outcomes. One engineering standard.</p>
      </div>

      <div class="practice-preview" aria-label="AR INFOTEK practices">
        <div class="preview-row preview-dev">
          <span class="preview-tag">Practice 01</span>
          <strong>Product Development</strong>
          <small>For businesses that need software shipped</small>
        </div>
        <div class="preview-row preview-training">
          <span class="preview-tag">Practice 02</span>
          <strong>IT Training</strong>
          <small>For learners who need real skills and roles</small>
        </div>
        <p class="preview-footer">Dedicated teams · Clear ownership · No mixed messaging</p>
      </div>
    </div>
  </section>

  <section class="section" id="tracks">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Choose a practice</span>
        <h2>Two tracks. Each built for a specific outcome.</h2>
        <p>Pick the path that matches your goal. Navigation, forms and support change with your choice so you only see what matters.</p>
      </div>
      <div class="track-grid">
        {tracks.map((track) => (
          <div class={`track-card ${track.tone}`}>
            <div class="track-top">
              <span>{track.label}</span>
              <span class="track-audience">{track.audience}</span>
            </div>
            <h3>{track.title}</h3>
            <p>{track.summary}</p>
            <ul class="checks">
              {track.points.map((point) => <li>{point}</li>)}
            </ul>
            <a class="btn" href={track.href}>{track.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container split-section">
      <div>
        <span class="eyebrow">Product development</span>
        <h2>From idea to production, without hand-off confusion.</h2>
        <p>We take ownership across discovery, design, engineering, deployment and support. Every project runs with clear milestones and transparent progress updates.</p>
        <a class="btn blue" href={`${base}software-development/`}>See product services</a>
      </div>
      <div class="flow-grid">
        {devFlow.map((step) => (
          <div class="flow-step">
            <span class="step-no">{step.no}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-section reverse">
      <div class="flow-grid">
        {trainingFlow.map((step) => (
          <div class="flow-step">
            <span class="step-no">{step.no}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
      <div>
        <span class="eyebrow">IT training</span>
        <h2>Learn by building systems that look like real work.</h2>
        <p>Live mentor-led sessions, guided labs and capstone projects in Cloud, DevOps, Data Science, AI/ML and Cybersecurity. Batches run on weekdays and weekends.</p>
        <div class="hero-actions">
          <a class="btn" href={`${base}courses/`}>Browse courses</a>
          <a class="btn outline" href={`${base}placement/`}>Placement support</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Why AR INFOTEK</span>
        <h2>Standards that travel across both practices.</h2>
        <p>Whether we are shipping a product or training a learner, the same engineering discipline shapes the work.</p>
      </div>
      <div class="grid three proof-grid">
        {proof.map((item) => (
          <div class="card">
            <span class="proof-label">{item.label}</span>
            <div class="proof-title">{item.title}</div>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Representative engagements</span>
      <h2>How we approach client problems.</h2>
      <div class="grid three">
        {studies.map(([title, text]) => (
          <div class="card"><h3>{title}</h3><p>{text}</p><a href={`${base}case-studies/`}>Read the pattern →</a></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="batch-band">
        <div>
          <span class="eyebrow">Starting soon</span>
          <h3>Live batches, small cohorts.</h3>
          <p>Weekday sessions 7–9 PM IST; weekend sessions 10 AM–1 PM IST.</p>
        </div>
        <a class="btn" href={`${base}batches/`}>View all batches</a>
      </div>
      <div class="table-wrap batch-table">
        <table>
          <thead><tr><th>Program</th><th>Starts</th><th>Schedule</th><th>Availability</th></tr></thead>
          <tbody>
            {batches.map((batch) => (
              <tr><td>{batch.name}</td><td>{batch.date}</td><td>{batch.mode}</td><td>{batch.seats}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-panel">
      <div>
        <span class="eyebrow">Still deciding?</span>
        <h2>Not sure which track fits?</h2>
        <p>Tell us what you are trying to achieve. We will point you to the right practice, whether that is a product build or a training track.</p>
      </div>
      <div class="hero-actions">
        <a class="btn" href={`${base}contact/`}>Talk to an advisor</a>
        <a class="btn outline" href={`${base}pricing/`}>Compare options</a>
      </div>
    </div>
  </section>
</BaseLayout>
