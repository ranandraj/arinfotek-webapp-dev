---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const batches = [
  { name: 'AWS Architect', date: '25 Nov', mode: 'Weekdays', seats: '4 seats left' },
  { name: 'Data Science', date: '02 Dec', mode: 'Weekends', seats: '6 seats left' },
  { name: 'DevOps Master', date: '09 Dec', mode: 'Weekdays', seats: 'New batch' },
];
const reasons = [
  ['Live & Interactive', 'Ask doubts live and collaborate with mentors and peers in real time.'],
  ['Project-First', 'Ship apps, dashboards and deployments you can show in interviews.'],
  ['Industry Experts', 'Learn from senior professionals with real-world delivery experience.'],
  ['Small Cohorts', 'Dedicated mentor attention and accountability throughout the course.'],
  ['Flexible Schedules', 'Weekday and weekend batches designed around your routine.'],
  ['Certificates', 'Get recognised for every skill you master with a completion certificate.'],
];
const labs = [
  ['Generative AI Bot', 'RAG chatbot over company PDFs using OpenAI, LangChain and vector databases.'],
  ['Serverless Neo-Bank', 'Event-driven banking backend with AWS Lambda and DynamoDB streams.'],
  ['GitOps K8s Cluster', 'Automated pipeline from GitHub push to zero-downtime Kubernetes deployment.'],
  ['SOC Threat Hunter', 'Live dashboard detecting SQL injection, DDoS and unauthorised access.'],
];
const testimonials = [
  ['Harish Kumar', 'Cloud Engineer @ StartupX', 'The AWS labs on VPC and IAM helped me design and deploy a production-ready architecture.'],
  ['Vikram Rao', 'Data Analyst @ RetailCorp', 'Python, Pandas and model building gave me true end-to-end data science skills.'],
  ['Neha Sharma', 'DevOps Engineer @ FinTechCo', 'Docker, Kubernetes and CI/CD practice made real deployments feel easy.'],
];
---
<BaseLayout>
  <section class="hero">
    <div class="container">
      <span class="tag">Software Development · IT Training</span>
      <h1>Build software. Build your career.</h1>
      <p>Practical, mentor-led technology education and reliable engineering services — from the same team that builds real systems.</p>
      <div class="hero-actions">
        <a class="btn" href={`${base}software-development/`}>Explore software services</a>
        <a class="btn ghost" href={`${base}courses/`}>Browse courses</a>
      </div>
      <div class="grid four" style="margin-top:3rem">
        <div><div class="stat">3k+</div><div class="stat-label">Learners trained</div></div>
        <div><div class="stat">4.8/5</div><div class="stat-label">Average rating</div></div>
        <div><div class="stat">100%</div><div class="stat-label">Practical sessions</div></div>
        <div><div class="stat">8</div><div class="stat-label">Internship domains</div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Two ways to work with us</span>
      <h2>One company, two focus areas</h2>
      <div class="grid two">
        <div class="card">
          <span class="tag">For businesses</span>
          <h3>Software Development</h3>
          <p>Web applications, APIs, cloud infrastructure, DevOps automation and AI integrations built with a production-first mindset. We take projects from discovery to deployment and ongoing support.</p>
          <ul class="checks">
            <li>Requirement analysis and solution design</li>
            <li>Agile delivery with clear milestones</li>
            <li>Secure, maintainable and documented code</li>
          </ul>
          <a class="btn outline" href={`${base}software-development/`}>See our services</a>
        </div>
        <div class="card">
          <span class="tag">For learners</span>
          <h3>IT Training</h3>
          <p>Live instructor-led courses in AI/ML, Cloud, DevOps, Data Science and Cybersecurity. Small cohorts, hands-on labs and career-focused projects prepare you for real roles.</p>
          <ul class="checks">
            <li>Weekday and weekend live batches</li>
            <li>Real projects and interview preparation</li>
            <li>Completion certificate and mentor support</li>
          </ul>
          <a class="btn outline" href={`${base}courses/`}>Explore courses</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="grid two">
        <div>
          <span class="eyebrow">Start soon</span>
          <h2>Upcoming batches</h2>
          <p>Live online, small cohorts. Weekday sessions 7–9 PM IST; weekend sessions 10 AM–1 PM IST.</p>
          <a class="btn" href={`${base}batches/`}>View all batches</a>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Program</th><th>Starts</th><th>Schedule</th><th>Availability</th></tr></thead>
            <tbody>
              {batches.map((batch) => (
                <tr><td>{batch.name}</td><td>{batch.date}</td><td>{batch.mode}</td><td>{batch.seats}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Why AR INFOTEK</span>
      <h2>Designed for speed and career impact</h2>
      <div class="grid three">
        {reasons.map(([title, text]) => (
          <div class="card"><h3>{title}</h3><p>{text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <span class="eyebrow">Innovation Labs</span>
      <h2>Learn by building real systems</h2>
      <p>Every learner works through four industry-style projects from scratch.</p>
      <div class="grid four">
        {labs.map(([title, text]) => (
          <div class="card"><h3>{title}</h3><p>{text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid two">
        <div>
          <span class="eyebrow">Internship Program 2026</span>
          <h2>Learn today. Intern tomorrow.</h2>
          <p>Real-world projects, industry exposure, resume building, interview preparation and a certificate on successful completion. Open to BE, BCA, BSc, MCA and diploma students.</p>
          <div class="grid four" style="margin-top:1.5rem">
            <div><div class="stat">₹1,999</div><div class="stat-label">Program fee</div></div>
            <div><div class="stat">8</div><div class="stat-label">Domains</div></div>
          </div>
          <div class="hero-actions"><a class="btn" href={`${base}internship/`}>Explore internship</a><a class="btn outline" href={`${base}signup/student/`}>Register</a></div>
        </div>
        <div class="card">
          <h3>Transparent pricing</h3>
          <p>Group training from ₹2,999 per course. 1:1 mentoring from ₹14,999. Long-term mentorship from ₹24,999.</p>
          <a href={`${base}pricing/`}>Compare all plans →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <span class="eyebrow">Learner stories</span>
      <h2>What our learners say</h2>
      <div class="grid three">
        {testimonials.map(([name, role, quote]) => (
          <div class="card">
            <p class="quote">“{quote}”</p>
            <div class="who">{name}</div>
            <p class="small">{role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <h2>Ready to get started?</h2>
      <p>Talk to an advisor, or create an account to access your dashboard.</p>
      <div class="hero-actions" style="justify-content:center">
        <a class="btn" href={`${base}contact/`}>Contact us</a>
        <a class="btn outline" href={`${base}signup/customer/`}>Customer signup</a>
        <a class="btn outline" href={`${base}signup/student/`}>Student signup</a>
      </div>
    </div>
  </section>
</BaseLayout>
