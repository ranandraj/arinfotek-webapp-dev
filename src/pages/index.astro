---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const tracks = [
  {
    label: 'Practice 01',
    audience: 'For businesses',
    title: 'Product Development',
    summary: 'Web applications, APIs, cloud infrastructure, DevOps automation and AI integrations built by practising engineers.',
    points: ['Discovery to deployment', 'Clear milestones and ownership', 'Secure, maintainable code'],
    href: `${base}software-development/`,
    cta: 'Explore product development',
    tone: 'dev',
  },
  {
    label: 'Practice 02',
    audience: 'For learners',
    title: 'IT Training',
    summary: 'Live instructor-led courses with hands-on labs, real projects, internships and placement support for real roles.',
    points: ['Weekday and weekend batches', 'Projects you can show', 'Placement and hiring mentor'],
    href: `${base}courses/`,
    cta: 'Explore IT training',
    tone: 'training',
  },
];

const deliverables = [
  { title: 'Discovery brief', text: 'Goals, users, constraints and success criteria documented before build work starts.' },
  { title: 'Design plan', text: 'Wireframes, architecture and a milestone-based delivery plan your team can review.' },
  { title: 'Production codebase', text: 'Reviewed, tested and documented code you own, with clear handover notes.' },
  { title: 'Launch and support', text: 'Deployment, monitoring and a defined path for fixes and future enhancements.' },
];

const devFlow = [
  { no: '01', title: 'Discover', text: 'Goals, users, constraints and success criteria.' },
  { no: '02', title: 'Design', text: 'Architecture, wireframes and a milestone plan.' },
  { no: '03', title: 'Build', text: 'Agile sprints with reviews, tests and updates.' },
  { no: '04', title: 'Launch', text: 'Deployment, monitoring and future enhancements.' },
];

const engagements = [
  {
    title: 'Operations dashboard',
    outcome: 'Clear role-based views for teams that relied on scattered spreadsheets.',
    stack: 'Web app · API · Access control',
  },
  {
    title: 'Document assistant',
    outcome: 'Cited answers from company PDFs instead of manual document searching.',
    stack: 'RAG · Vector search · Auth',
  },
  {
    title: 'Pipeline modernisation',
    outcome: 'Repeatable deployments replacing manual, error-prone release steps.',
    stack: 'Containers · CI/CD · Tests',
  },
];

const proof = [
  { label: 'Engineering standard', title: 'Production-first thinking', text: 'Software is designed for security, maintainability and clear documentation from day one.' },
  { label: 'Learning standard', title: 'Project-first teaching', text: 'Learners build dashboards, deployments and intelligent assistants instead of only watching lectures.' },
  { label: 'Outcome standard', title: 'Support after delivery', text: 'Clients get a support path; learners get a hiring mentor and a practical 90-day plan.' },
];
---
<BaseLayout
  title="AR INFOTEK | Product Development & IT Training"
  description="AR INFOTEK builds products for businesses and delivers live, mentor-led IT training for learners."
>
  <section class="hero hero-home">
    <div class="container hero-grid">
      <div>
        <span class="tag">One company · Two focused practices</span>
        <h1>Build the product. Build the people.</h1>
        <p>AR INFOTEK helps businesses ship software and helps learners build job-ready technology skills. Two dedicated teams, two clear outcomes, one engineering standard.</p>
        <div class="hero-choice">
          <a class="choice-btn" href="#product-spotlight">
            <strong>I need a product built</strong>
            <span>For businesses</span>
          </a>
          <a class="choice-btn choice-training" href="#training-strip">
            <strong>I want to learn a skill</strong>
            <span>For learners</span>
          </a>
        </div>
        <div class="hero-actions small">
          <a class="btn ghost" href={`${base}contact/`}>Talk to us</a>
        </div>
        <p class="hero-note">Different outcomes. One engineering standard.</p>
      </div>

      <div class="practice-preview" aria-label="AR INFOTEK practices">
        <div class="preview-row preview-dev">
          <span class="preview-tag">Practice 01</span>
          <strong>Product Development</strong>
          <small>For businesses that need software shipped</small>
        </div>
        <div class="preview-row preview-training">
          <span class="preview-tag">Practice 02</span>
          <strong>IT Training</strong>
          <small>For learners who need real skills and roles</small>
        </div>
        <p class="preview-footer">Dedicated teams · Clear ownership · No mixed messaging</p>
      </div>
    </div>
  </section>

  <section class="section" id="tracks">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Choose a practice</span>
        <h2>Two tracks. Each built for a specific outcome.</h2>
        <p>Pick the path that matches your goal. Navigation, forms and support change with your choice so you only see what matters.</p>
      </div>
      <div class="track-grid">
        {tracks.map((track) => (
          <div class={`track-card ${track.tone}`}>
            <div class="track-top">
              <span>{track.label}</span>
              <span class="track-audience">{track.audience}</span>
            </div>
            <h3>{track.title}</h3>
            <p>{track.summary}</p>
            <ul class="checks">
              {track.points.map((point) => <li>{point}</li>)}
            </ul>
            <a class="btn" href={track.href}>{track.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" id="product-spotlight">
    <div class="container split-section">
      <div>
        <span class="eyebrow">Product development</span>
        <h2>From idea to production, with one accountable team.</h2>
        <p>We take ownership across discovery, design, engineering, deployment and support. Every project runs with clear milestones and transparent progress updates.</p>
        <div class="model-row">
          <span>Fixed scope</span>
          <span>Dedicated team</span>
          <span>Consultation</span>
        </div>
        <div class="hero-actions">
          <a class="btn" href={`${base}contact/`}>Book a discovery call</a>
          <a class="btn blue" href={`${base}software-development/`}>See product services</a>
        </div>
      </div>
      <div class="deliverables">
        {deliverables.map((item) => (
          <div class="deliverable">
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="container flow-wrap">
      <div class="flow-grid">
        {devFlow.map((step) => (
          <div class="flow-step">
            <span class="step-no">{step.no}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Representative engagement patterns</span>
        <h2>Proof lives in the work, not just the pitch.</h2>
        <p>These are example problem patterns and the outputs we design for. Read the full pattern notes on the case studies page.</p>
      </div>
      <div class="grid three">
        {engagements.map((item) => (
          <div class="card engagement-card">
            <h3>{item.title}</h3>
            <div class="engagement-outcome">{item.outcome}</div>
            <span class="engagement-stack">{item.stack}</span>
            <p><a href={`${base}case-studies/`}>Read the pattern →</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" id="training-strip">
    <div class="container training-strip">
      <div>
        <span class="eyebrow">IT training</span>
        <h2>Live, mentor-led learning with real projects.</h2>
        <p>Cloud, DevOps, Data Science, AI/ML and Cybersecurity. Weekday and weekend batches, capstone projects and placement support.</p>
      </div>
      <div class="hero-actions">
        <a class="btn" href={`${base}courses/`}>Explore IT training</a>
        <a class="btn outline" href={`${base}batches/`}>Upcoming batches</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Why AR INFOTEK</span>
        <h2>Standards that travel across both practices.</h2>
        <p>Whether we are shipping a product or training a learner, the same engineering discipline shapes the work.</p>
      </div>
      <div class="grid three proof-grid">
        {proof.map((item) => (
          <div class="card">
            <span class="proof-label">{item.label}</span>
            <div class="proof-title">{item.title}</div>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container cta-panel">
      <div>
        <span class="eyebrow">Start a conversation</span>
        <h2>Have a product idea? Let's scope it.</h2>
        <p>Tell us what you want to build and we will map the discovery, delivery plan and next step. Looking for training instead? Explore the courses track.</p>
      </div>
      <div class="hero-actions">
        <a class="btn" href={`${base}contact/`}>Book a discovery call</a>
        <a class="btn outline" href={`${base}courses/`}>Explore IT training</a>
      </div>
    </div>
  </section>
</BaseLayout>
